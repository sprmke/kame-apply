{
  "name": "kame-apply",
  "private": true,
  "version": "0.0.0",
  "description": "Kame Apply monorepo root. Phase 0: AI tooling only; the workspace lands in Phase 1.",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "setup:ai-tooling": "bash scripts/dev/setup-ai-tooling.sh",
    "check:ai-tooling-sync": "bash scripts/dev/check-ai-tooling-sync.sh",
    "check:filenames": "bash scripts/dev/check-filename-conventions.sh",
    "check:stack-terminology": "bash scripts/dev/check-stack-terminology.sh",
    "check:hooks": "bash scripts/dev/test-hooks.sh",
    "env:status": "bash scripts/dev/env-status.sh",
    "dev:free-ports": "bash scripts/dev/free-local-ports.sh",
    "ci:quality": "bash scripts/dev/ci-quality-gate.sh",
    "dev:docker": "docker compose -f infra/docker-compose.dev.yml up -d --wait && bash scripts/dev/ensure-db-roles.sh",
    "stop:docker": "docker compose -f infra/docker-compose.dev.yml down",
    "dev": "bash dev.sh",
    "dev:api": "cd apps/api && uv run uvicorn app.main:app --reload --port 8100",
    "dev:web": "pnpm --filter @kame/web dev",
    "db:migrate": "cd apps/api && uv run alembic upgrade head",
    "db:migrate:new": "cd apps/api && uv run alembic revision --autogenerate -m",
    "db:reset:local": "bash scripts/dev/db-reset-local.sh",
    "db:seed": "uv run python scripts/taxonomy/refresh.py --seed --fx",
    "gen:api-client": "bash scripts/dev/gen-api-client.sh",
    "check:api-client": "bash scripts/dev/gen-api-client.sh --check",
    "lint": "uv run ruff check . && uv run ruff format --check . && pnpm -r --if-present run lint",
    "lint:fix": "uv run ruff check . --fix && uv run ruff format . && pnpm -r --if-present run lint:fix",
    "format": "uv run ruff format . && prettier --write .",
    "format:check": "uv run ruff format --check . && prettier --check .",
    "type-check": "uv run basedpyright && pnpm -r --if-present run type-check",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm run test:api && pnpm run test:web",
    "test:api": "uv run pytest apps/api -q && uv run pytest apps/runner -q",
    "test:evals-lite": "uv run pytest apps/api/tests/evals -q -m 'not live'",
    "test:evals": "uv run pytest apps/api/tests/evals -q -m 'not live'",
    "test:web": "pnpm -r --if-present run test",
    "migrate:dev": "bash scripts/deploy/migrate-remote.sh dev",
    "migrate:prod": "bash scripts/deploy/migrate-remote.sh prod",
    "backup:db:dev": "bash scripts/deploy/backup-db.sh dev",
    "backup:db:prod": "bash scripts/deploy/backup-db.sh prod",
    "rollback:db:dev": "bash scripts/deploy/restore-db.sh dev",
    "rollback:db:prod": "bash scripts/deploy/restore-db.sh prod",
    "deploy:free": "bash scripts/deploy/deploy-free.sh",
    "deploy:api:dev": "bash scripts/deploy/deploy-api.sh dev",
    "deploy:api:prod": "bash scripts/deploy/deploy-api.sh prod",
    "deploy:web:dev": "bash scripts/deploy/deploy-web.sh dev",
    "deploy:web:prod": "bash scripts/deploy/deploy-web.sh prod",
    "deploy:runner:prod": "bash scripts/deploy/deploy-runner.sh prod",
    "restore:drill:local": "bash scripts/deploy/restore-drill-local.sh",
    "check:a11y-smoke": "bash scripts/dev/a11y-smoke.sh",
    "check:token-contrast": "node scripts/dev/check-token-contrast.mjs",
    "test:e2e": "playwright test",
    "check:design-slop": "bash scripts/dev/check-design-slop.sh",
    "deploy:runner:dev": "bash scripts/deploy/deploy-runner.sh dev",
    "migrate:host:dev": "bash scripts/deploy/migrate-host.sh dev",
    "migrate:host:prod": "bash scripts/deploy/migrate-host.sh prod",
    "db:roles:host:dev": "bash scripts/deploy/ensure-host-db-roles.sh dev",
    "db:roles:host:prod": "bash scripts/deploy/ensure-host-db-roles.sh prod"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.4.0",
    "turbo": "^2.11.10"
  }
}

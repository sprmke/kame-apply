{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".cursor/rules/project-context.mdc",
    ".cursor/rules/ai-usage.mdc",
    ".cursor/rules/documentation-maintenance.mdc",
    ".cursor/rules/ui-minimal-copy.mdc",
    ".cursor/rules/human-copy.mdc",
    ".cursor/rules/superpowers-opt-in.mdc",
    ".cursor/rules/git-commits.mdc",
    ".cursor/rules/no-prod-deploy.mdc",
    ".cursor/rules/markitdown-mcp.mdc",
    ".cursor/rules/route-guides.mdc",
    ".cursor/rules/audit-logging.mdc",
    ".cursor/rules/job-site-access.mdc",
    ".cursor/rules/pii-guard.mdc",
    ".cursor/rules/workspace-scoping.mdc",
    ".cursor/rules/untrusted-content.mdc",
    ".cursor/rules/truthful-content.mdc",
    "DESIGN.md"
  ],
  "skills": [".agent/skills", ".agents/skills"],
  "formatter": true,
  "experimental": {
    "todo": true
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "local",
        "command": ["npx", "-y", "@upstash/context7-mcp"]
      },
      "markitdown": {
        "type": "local",
        "command": ["markitdown-mcp"]
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"]
      },
      "postgres": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-postgres",
          "postgresql://kame_apply_ro:kame_apply_ro_local_only@127.0.0.1:5442/kame_apply"
        ]
      }
    }
  },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rm -rf /", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~/*", "effect": "deny" },
    { "action": "shell", "resource": "*deploy:api:prod*", "effect": "deny" },
    { "action": "shell", "resource": "*deploy:web:prod*", "effect": "deny" },
    { "action": "shell", "resource": "*deploy:runner:prod*", "effect": "deny" },
    { "action": "shell", "resource": "*migrate:prod*", "effect": "deny" },
    { "action": "shell", "resource": "*rollback:db:prod*", "effect": "deny" },
    { "action": "shell", "resource": "*alembic upgrade*neon.tech*", "effect": "deny" },
    { "action": "shell", "resource": "*drop table*", "effect": "ask" },
    { "action": "shell", "resource": "*DROP TABLE*", "effect": "ask" },
    { "action": "shell", "resource": "*push --force*", "effect": "ask" },
    { "action": "shell", "resource": "*push -f*", "effect": "ask" },
    { "action": "shell", "resource": "*applywave*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "apps/api/migrations/versions/*", "effect": "deny" },
    { "action": "edit", "resource": "*apps/api/migrations/versions/*", "effect": "deny" },
    { "action": "edit", "resource": ".env.production*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.production*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.agents/*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" }
  ]
}

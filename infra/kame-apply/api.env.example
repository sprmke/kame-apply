# Host API environment. Copy to /etc/kame-apply/api.env and fill every CHANGE_ME.
# Never commit the filled file.

ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=true

# Compose service names, not localhost. Use the same passwords as POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://kame_apply_app:CHANGE_ME_APP_PASSWORD@postgres:5432/kame_apply
MIGRATION_DATABASE_URL=postgresql+asyncpg://kame_apply:CHANGE_ME_OWNER_PASSWORD@postgres:5432/kame_apply

API_BASE_URL=https://api.dev.example.com
WEB_BASE_URL=https://app.dev.example.com
CORS_ORIGINS=["https://app.dev.example.com"]

# Generate strong values; prod refuses the local defaults.
JWT_SECRET=CHANGE_ME_OPENSSL_RAND_BASE64_48
MASTER_KEK=CHANGE_ME_BASE64_32_BYTES
COOKIE_SECURE=true
AUTH_RATE_LIMIT_ENABLED=true

# Cloudflare R2
S3_ENDPOINT_URL=https://CHANGE_ME_ACCOUNT.r2.cloudflarestorage.com
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=kame-apply
S3_REGION=auto

# Resend (or leave empty to use SMTP; deployed mail needs one of them)
RESEND_API_KEY=CHANGE_ME
MAIL_FROM=Kame Apply <no-reply@example.com>

# Optional
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SENTRY_DSN=
# GITHUB_FEEDBACK_TOKEN=
# GITHUB_FEEDBACK_REPO=kame-hq/kame-apply
# DBOS_SYSTEM_DATABASE_URL=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=/etc/kame-apply/vapid_private.pem
# VAPID_SUBJECT=mailto:ops@example.com
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
# INBOUND_EMAIL_DOMAIN=in.example.com
# INBOUND_WEBHOOK_SECRET=

SCHEDULER_ENABLED=true
AUTO_SUBMIT_ENABLED=false
AGENT_BRIDGE_ENABLED=true

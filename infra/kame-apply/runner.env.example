# Host runner environment. Copy to /etc/kame-apply/runner.env.
# Create the token in the app: Settings -> Runs -> New runner token.
KAME_RUNNER_API_BASE=http://api:8100
KAME_RUNNER_TOKEN=CHANGE_ME
KAME_RUNNER_WORKSPACE_ID=CHANGE_ME_WORKSPACE_UUID
KAME_RUNNER_RUNNER_ID=vm-1
KAME_RUNNER_MODE=cloud
KAME_RUNNER_HEADED=false
KAME_RUNNER_MAX_CONCURRENCY=2

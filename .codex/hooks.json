{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/compat_hook.py\" .codex/hooks/guard-shell.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/compat_hook.py\" .codex/hooks/guard-shipped-migrations.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Task|Agent|spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/compat_hook.py\" .codex/hooks/guard-superpowers-subagents.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/compat_hook.py\" .codex/hooks/format-edited-file.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/compat_hook.py\" .codex/hooks/check-stack-terminology.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/compat_hook.py\" .codex/hooks/remind-docs-on-code-edit.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/compat_hook.py\" .codex/hooks/session-superpowers-opt-in.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/compat_hook.py\" .codex/hooks/session-ai-tooling-sync.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/compat_hook.py\" .codex/hooks/session-docs-sync-reminder.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/compat_hook.py\" .codex/hooks/session-workflow-in-progress.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/compat_hook.py\" .codex/hooks/superpowers-lean-mode.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/compat_hook.py\" .codex/hooks/superpowers-lean-cleanup.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
